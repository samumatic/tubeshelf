# better-auth only declares better-sqlite3 as a peerOptional dependency
# capped at ^12, so a strict `npm ci`/`npm install` fails outright on
# better-sqlite3 13 even though better-auth works fine with it in practice
# (it just accepts a Database instance duck-typed, not version-checked).
# Remove this once better-auth widens its own peer range.
legacy-peer-deps=true
